{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flip：主控操作台",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tools/dev.py",
      "args": [
        "menu"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONUTF8": "1",
        "PYTHONUNBUFFERED": "1"
      }
    },
    {
      "name": "Flip：檢查環境",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tools/dev.py",
      "args": [
        "doctor"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONUTF8": "1",
        "PYTHONUNBUFFERED": "1"
      }
    },
    {
      "name": "Flip：建置兩板",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tools/build.py",
      "args": [
        "build"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONUTF8": "1",
        "PYTHONUNBUFFERED": "1"
      }
    },
