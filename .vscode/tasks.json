  "inputs": [
    {
      "id": "hour",
      "type": "promptString",
      "description": "實物目前顯示小時 0–23；僅完整落頁後確認",
      "default": "10"
    },
    {
      "id": "minute",
      "type": "promptString",
      "description": "實物目前顯示分鐘 0–59",
      "default": "30"
    },
    {
      "id": "steps",
      "type": "promptString",
      "description": "微調半步數（正式版僅正向 1–256）",
      "default": "4"
    },
    {
      "id": "pages",
      "type": "promptString",
      "description": "前進頁數 1–60",
      "default": "1"
    },
    {
      "id": "configValues",
      "type": "promptString",
      "description": "設定物件 JSON；先修改 RAM，再另行保存",
      "default": "{\"mechanics_confirmed\":true,\"cycle_minutes\":720}"
    },
    {
      "id": "planId",
      "type": "promptString",
      "description": "最新追趕預覽中的 plan_id，須在 30 秒內使用",
      "default": ""
    },
    {
      "id": "pendingSync",
      "type": "promptString",
      "description": "狀態中 pending_sync_utc 的實際整數值",
      "default": ""
    },
    {
      "id": "ntpServers",
      "type": "promptString",
      "description": "NTP 設定 JSON",
      "default": "{\"servers\":[\"pool.ntp.org\",\"time.cloudflare.com\",\"time.google.com\"]}"
    },
    {
      "id": "confirmLarge",
      "type": "pickString",
      "description": "是否明確允許超限的向前追趕？",
      "options": [
        "false",
        "true"
      ],
      "default": "false"
    }
  ]
}
